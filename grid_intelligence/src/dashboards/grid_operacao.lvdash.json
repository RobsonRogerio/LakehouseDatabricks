            "queries": [{
              "name": "main_query",
              "query": {
                "datasetName": "ds_ouvidoria",
                "fields": [
                  {"name": "id_cliente", "expression": "`id_cliente`"},
                  {"name": "nome_conjunto", "expression": "`nome_conjunto`"},
                  {"name": "bairro", "expression": "`bairro`"},
                  {"name": "qtd_chamados", "expression": "`qtd_chamados`"},
                  {"name": "qtd_mencoes_ouvidoria", "expression": "`qtd_mencoes_ouvidoria`"},
                  {"name": "reincidente", "expression": "`reincidente`"},
                  {"name": "motivo_predominante", "expression": "`motivo_predominante`"},
                  {"name": "ultima_fala", "expression": "`ultima_fala`"},
                  {"name": "ultimo_chamado_em", "expression": "`ultimo_chamado_em`"}
                ],
                "disaggregated": true
              }
            }],
            "spec": {
              "version": 2,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  {"fieldName": "id_cliente", "displayName": "Cliente"},
                  {"fieldName": "nome_conjunto", "displayName": "Conjunto"},
                  {"fieldName": "bairro", "displayName": "Bairro"},
                  {"fieldName": "qtd_chamados", "displayName": "Chamados"},
                  {"fieldName": "qtd_mencoes_ouvidoria", "displayName": "Mencoes a ouvidoria"},
                  {"fieldName": "reincidente", "displayName": "Reincidente"},
                  {"fieldName": "motivo_predominante", "displayName": "Motivo predominante"},
