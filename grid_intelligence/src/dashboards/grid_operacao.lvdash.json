                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Clientes em rota de ouvidoria",
                "showDescription": true,
                "description": "Texto ja passou pela anonimizacao (RN-09): nome, CPF e telefone foram removidos antes de qualquer analise de conteudo."
              }
            }
          },
          "position": {"x": 0, "y": 15, "width": 12, "height": 6}
        }
      ]
    }
  ],
